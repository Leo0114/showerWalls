---
import { FiAlertTriangle, FiCheck, FiX } from "react-icons/fi";

interface Props {
  title?: string;
  description?: string;
  items: readonly string[];
  /** Sets the marker glyph and its colour. */
  tone?: "check" | "cross" | "note";
  class?: string;
}

const {
  title,
  description,
  items,
  tone = "check",
  class: className = "",
} = Astro.props;

const MARKERS = {
  check: { Icon: FiCheck, chip: "bg-primary/10 text-strategic" },
  cross: { Icon: FiX, chip: "bg-muted/15 text-muted" },
  note: { Icon: FiAlertTriangle, chip: "bg-secondary/20 text-primaryDark dark:text-secondary" },
} as const;

const { Icon, chip } = MARKERS[tone];
---

<div class={className}>
  {title && <h3 class="type-heading text-ink">{title}</h3>}
  {
    description && (
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-pretty text-muted">{description}</p>
    )
  }

  <ul class:list={["space-y-3.5", (title || description) && "mt-6"]}>
    {
      items.map((item) => (
        <li class="flex items-start gap-3">
          <span
            class:list={[
              "mt-px inline-flex h-5.5 w-5.5 shrink-0 items-center justify-center rounded-full",
              chip,
            ]}
          >
            <Icon className="h-3 w-3" aria-hidden="true" />
          </span>
          <span class="text-sm leading-relaxed text-pretty text-muted">{item}</span>
        </li>
      ))
    }
  </ul>
</div>
