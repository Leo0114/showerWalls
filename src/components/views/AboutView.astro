---
import { Image } from "astro:assets";
import { FiTarget, FiEye } from "react-icons/fi";
import placeholder from "@/assets/images/placeholder.jpeg";
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/shared/Banner.astro";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import CtaSection from "@/components/shared/CtaSection.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const about = i18n.about_us;
const pillars = [
  { ...about.mission, Icon: FiTarget },
  { ...about.vision, Icon: FiEye },
];
---

<Layout title={about.title} description={about.description}>
  <Banner
    title={about.title}
    subtitle={about.banner_subtitle}
    image={placeholder}
    imageAlt={about.title}
  />

  <section class="section-y bg-canvas">
    <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading eyebrow={about.eyebrow} title={about.heading} description={about.description} />
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted">
          {about.description_secondary}
        </p>
      </div>

      <ScrollReveal client:visible direction="left">
        <div class="relative aspect-4/5 overflow-hidden rounded-[2rem]">
          <Image
            src={placeholder}
            alt={about.heading}
            widths={[480, 768, 1024]}
            sizes="(min-width: 1024px) 45vw, 90vw"
            class="h-full w-full object-cover"
          />
        </div>
      </ScrollReveal>
    </div>
  </section>

  <section class="section-y bg-panel">
    <div class="container-x grid gap-6 md:grid-cols-2">
      {
        pillars.map(({ title, text, Icon }, index) => (
          <ScrollReveal client:visible delay={index * 0.1} className="h-full">
            <article class="flex h-full flex-col rounded-3xl border border-line bg-canvas p-9">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary">
                <Icon className="h-5 w-5" aria-hidden="true" />
              </span>
              <h2 class="mt-6 font-display text-2xl font-bold text-ink">{title}</h2>
              <p class="mt-4 text-base leading-relaxed text-muted">{text}</p>
            </article>
          </ScrollReveal>
        ))
      }
    </div>
  </section>

  <section class="section-y bg-canvas">
    <div class="container-x">
      <SectionHeading title={about.values.title} align="center" />

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          about.values.items.map(({ title, description }, index) => (
            <ScrollReveal client:visible delay={index * 0.08} className="h-full">
              <article class="flex h-full flex-col border-t-2 border-primary/20 pt-6 transition-colors duration-500 hover:border-primary">
                <span class="font-display text-3xl font-bold text-primary/30">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-4 font-display text-lg font-semibold text-ink">{title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-muted">{description}</p>
              </article>
            </ScrollReveal>
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection
    title={about.cta.title}
    description={about.cta.description}
    primaryLabel={about.cta.primary}
    primaryHref={path("contact")}
    secondaryLabel={about.cta.secondary}
    secondaryHref={path("products")}
  />
</Layout>
