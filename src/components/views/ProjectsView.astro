---
import Layout from "@/layouts/Layout.astro";
import bannerImage from "@/assets/images/w.avif";
import Banner from "@/components/shared/Banner.astro";
import CtaSection from "@/components/shared/CtaSection.astro";
import ProjectsGrid from "@/components/projects/ProjectsGrid";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";

// Static assets — resolved at build time and passed as plain string URLs
// so the React island never needs Astro's asset pipeline.
import hospitalityImg from "@/assets/images/projects/hospital.avif";
import multifamilyImg from "@/assets/images/projects/multifam.avif";
import seniorlivingImg from "@/assets/images/projects/student.avif";

import rawProjects from "@/constants/proyectos.json";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

// Strip Dirección — we don't expose it in the UI — and narrow types.
const projects = rawProjects.map(({ Dirección: _d, ...rest }) => rest);

// Pass resolved image src strings; Astro's ImageMetadata carries `.src`.
const typeImages: Record<string, string> = {
  Hospitality: hospitalityImg.src,
  Multifamily: multifamilyImg.src,
  Seniorliving: seniorlivingImg.src,
};
---

<Layout title={i18n.projects.title} description={i18n.projects.subtitle}>
  <Banner
    title={i18n.projects.title}
    subtitle={i18n.projects.banner_subtitle}
    image={bannerImage}
    imageAlt={i18n.projects.title}
  />

  <section class="section-y bg-canvas">
    <div class="container-x">
      <p class="max-w-2xl text-base leading-relaxed text-muted">
        {i18n.projects.intro}
      </p>

      <!-- React island: search + filter + paginated grid -->
      <div class="mt-10">
        <ProjectsGrid
          client:load
          projects={projects}
          i18n={i18n.projects}
          typeImages={typeImages}
        />
      </div>
    </div>
  </section>

  <CtaSection
    eyebrow={i18n.home.cta.eyebrow}
    title={i18n.projects.detail.cta.title}
    description={i18n.projects.detail.cta.description}
    primaryLabel={i18n.projects.detail.cta.primary}
    primaryHref={path("contact")}
    secondaryLabel={i18n.nav.products}
    secondaryHref={path("products")}
  />
</Layout>
