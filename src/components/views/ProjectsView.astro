---
import placeholder from "@/assets/images/placeholder.jpeg";
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/shared/Banner.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import CtaSection from "@/components/shared/CtaSection.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";
import { getProjects } from "@/lib/content";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const projects = await getProjects(lang);
---

<Layout title={i18n.projects.title} description={i18n.projects.subtitle}>
  <Banner
    title={i18n.projects.title}
    subtitle={i18n.projects.banner_subtitle}
    image={placeholder}
    imageAlt={i18n.projects.title}
  />

  <section class="section-y bg-canvas">
    <div class="container-x">
      <p class="max-w-2xl text-base leading-relaxed text-muted">{i18n.projects.intro}</p>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {
          projects.map((project, index) => (
            <ScrollReveal client:visible delay={index * 0.08} className="h-full">
              <ProjectCard
                project={project}
                href={path("projects", project.data.slug)}
                label={i18n.projects.view_details}
              />
            </ScrollReveal>
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection
    eyebrow={i18n.home.cta.eyebrow}
    title={i18n.projects.detail.cta.title}
    description={i18n.projects.detail.cta.description}
    primaryLabel={i18n.projects.detail.cta.primary}
    primaryHref={path("contact")}
    secondaryLabel={i18n.nav.products}
    secondaryHref={path("products")}
  />
</Layout>
