---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { FiArrowLeft, FiArrowUpRight } from "react-icons/fi";
import Layout from "@/layouts/Layout.astro";
import Gallery from "@/components/shared/Gallery.astro";
import CtaSection from "@/components/shared/CtaSection.astro";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";
import { getRelatedProducts, type Product } from "@/lib/content";
import { DEFAULT_GALLERY } from "@/constants/site";
import { CUTOUT_CATEGORIES } from "@/components/products/ProductExplorer";
import { patternsData } from "@/constants/patterns";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { Content } = await render(product);

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const { title, excerpt, code, category, cover, specs, gallery, madeToOrder, slug, surfaceFinishes, resources } =
  product.data;
const categoryCopy = i18n.products.categories[category];
const related = await getRelatedProducts(product);

// Surface finishes read as one more spec row, so the table keeps a single layout.
let specRows = surfaceFinishes?.length
  ? [
      ...specs,
      {
        label: i18n.products.detail.surface_finish,
        value: surfaceFinishes.map((f) => i18n.products.detail.surface_finishes[f]).join(" · "),
      },
    ]
  : [...specs];

if (category === "tub-shower-surrounds") {
  const patternInfo = patternsData.find((p) => title.toLowerCase().includes(p.pattern.toLowerCase()) || p.pattern.toLowerCase().includes(title.toLowerCase()));
  if (patternInfo) {
    const existingLabels = new Set(specRows.map(s => s.label.toLowerCase()));
    if (!existingLabels.has("height") && patternInfo.height) {
      specRows.push({ label: "Height", value: patternInfo.height });
    }
    if (!existingLabels.has("material") && patternInfo.material) {
      specRows.push({ label: "Material", value: patternInfo.material });
    }
    if (!existingLabels.has("panel width") && patternInfo.panelWidth) {
      specRows.push({ label: "Panel Width", value: patternInfo.panelWidth });
    }
    if (!existingLabels.has("thickness") && patternInfo.thickness) {
      specRows.push({ label: "Thickness", value: patternInfo.thickness });
    }
  }
}

const isCutout = CUTOUT_CATEGORIES.has(category);
---

<Layout title={title} description={excerpt}>
  <section class="border-b border-line bg-panel">
    <div class="container-x grid gap-12 py-14 lg:grid-cols-2 lg:items-center lg:py-20">
      <div>
        <a
          href={`${path("products")}?category=${category}`}
          class="press type-label inline-flex items-center gap-2 text-muted hover:text-strategic"
        >
          <FiArrowLeft className="h-4 w-4" aria-hidden="true" />
          {i18n.products.detail.back}
        </a>

        <p class="type-label mt-8 flex flex-wrap items-center gap-3 text-strategic">
          {code && (
            <span class="rounded-full bg-primary/10 px-3 py-1">{i18n.products.code}: {code}</span>
          )}
          <span>{categoryCopy.name}</span>
        </p>

        <h1
          class="type-display mt-5 text-ink"
          transition:name={`product-title-${slug}`}
        >
          {title}
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted">{excerpt}</p>

        {
          madeToOrder && (
            <p class="type-label mt-6 inline-flex rounded-full border border-primary/30 bg-primary/5 px-4 py-2 text-strategic">
              Made to order
            </p>
          )
        }

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={path("contact")}
            class="btn btn-primary group"
          >
            {i18n.products.request_sample}
            <FiArrowUpRight
              className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>

      <div class:list={["relative overflow-hidden rounded-[2rem] border border-line", isCutout ? "aspect-square bg-canvas p-8 lg:p-12" : "aspect-4/3"]}>
        <Image
          src={cover}
          alt={title}
          widths={[480, 768, 1280]}
          sizes="(min-width: 1024px) 48vw, 92vw"
          loading="eager"
          class:list={["h-full w-full", isCutout ? "object-contain drop-shadow-[0_14px_18px_rgb(0_0_0/0.14)]" : "object-cover"]}
          transition:name={`product-image-${slug}`}
        />
      </div>
    </div>
  </section>

  <section class="section-y bg-canvas">
    <div class="container-x grid gap-14 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
      <div class="prose prose-neutral max-w-none dark:prose-invert prose-headings:font-display prose-a:text-strategic">
        <Content />
      </div>

      {
        specRows.length > 0 && (
          <aside class="surface-card h-fit rounded-3xl bg-panel p-8">
            <h2 class="type-heading text-ink">{i18n.products.detail.specs}</h2>
            <dl class="mt-6 divide-y divide-line">
              {specRows.map(({ label, value }) => (
                <div class="flex items-start justify-between gap-6 py-3.5">
                  <dt class="text-sm text-muted">{label}</dt>
                  <dd class="text-right text-sm font-medium text-ink">{value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        )
      }
    </div>
  </section>

  {
    gallery && (
      <section class="section-y bg-panel pt-0">
        <div class="container-x">
          <Gallery
            name={gallery ?? DEFAULT_GALLERY}
            title={i18n.products.detail.gallery_title}
            alt={title}
            standardGrid={true}
          />
        </div>
      </section>
    )
  }

  {
    resources && (
      <section class="section-y bg-canvas">
        <div class="container-x">
          <h2 class="type-heading text-ink">Resources</h2>
          <div class="mt-8">
            <a href="#" class="btn btn-outline">
              Download Resources
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section-y bg-canvas">
        <div class="container-x">
          <h2 class="type-heading text-ink">{i18n.products.detail.related}</h2>

          <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((item) => (
              <li>
                <a
                  href={path("products", item.data.slug)}
                  class="surface-card press-soft group flex h-full flex-col overflow-hidden rounded-2xl hover:-translate-y-1 hover:border-primary/40 hover:shadow-e2"
                >
                  <div class:list={["overflow-hidden", CUTOUT_CATEGORIES.has(item.data.category) ? "aspect-square bg-canvas p-4" : "aspect-4/3"]}>
                    <Image
                      src={item.data.cover}
                      alt={item.data.title}
                      width={400}
                      height={300}
                      class={CUTOUT_CATEGORIES.has(item.data.category) ? "h-full w-full object-contain drop-shadow-[0_14px_18px_rgb(0_0_0/0.14)] transition-transform duration-500 ease-out group-hover:scale-[1.03]" : "h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"}
                    />
                  </div>
                  <div class="flex flex-1 flex-col p-5">
                    {item.data.code && (
                      <span class="type-label text-strategic">
                        {item.data.code}
                      </span>
                    )}
                    <h3 class="mt-1.5 font-display text-sm font-semibold leading-snug text-ink">
                      {item.data.title}
                    </h3>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaSection
    title={i18n.products.detail.cta.title}
    description={i18n.products.detail.cta.description}
    primaryLabel={i18n.products.detail.cta.primary}
    primaryHref={path("contact")}
    secondaryLabel={i18n.products.detail.cta.secondary}
    secondaryHref={path("products")}
  />
</Layout>
