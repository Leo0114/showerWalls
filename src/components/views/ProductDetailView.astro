---
import { Image } from "astro:assets";
import { render } from "astro:content";
import { FiArrowLeft, FiArrowUpRight } from "react-icons/fi";
import Layout from "@/layouts/Layout.astro";
import Gallery from "@/components/shared/Gallery.astro";
import CtaSection from "@/components/shared/CtaSection.astro";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";
import { getRelatedProducts, type Product } from "@/lib/content";
import { DEFAULT_GALLERY } from "@/constants/site";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { Content } = await render(product);

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const { title, excerpt, code, category, cover, specs, gallery, madeToOrder, slug } = product.data;
const categoryCopy = i18n.products.categories[category];
const related = await getRelatedProducts(product);
---

<Layout title={title} description={excerpt}>
  <section class="border-b border-line bg-panel">
    <div class="container-x grid gap-12 py-14 lg:grid-cols-2 lg:items-center lg:py-20">
      <div>
        <a
          href={`${path("products")}?category=${category}`}
          class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-muted transition-colors hover:text-primary"
        >
          <FiArrowLeft className="h-4 w-4" aria-hidden="true" />
          {i18n.products.detail.back}
        </a>

        <p class="mt-8 flex flex-wrap items-center gap-3 text-xs font-semibold uppercase tracking-[0.2em] text-primary">
          <span class="rounded-full bg-primary/10 px-3 py-1">{i18n.products.code}: {code}</span>
          <span>{categoryCopy.name}</span>
        </p>

        <h1
          class="mt-5 font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-balance text-ink sm:text-5xl"
          transition:name={`product-title-${slug}`}
        >
          {title}
        </h1>

        <p class="mt-6 max-w-xl text-base leading-relaxed text-muted">{excerpt}</p>

        {
          madeToOrder && (
            <p class="mt-6 inline-flex rounded-full border border-primary/30 bg-primary/5 px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-primary">
              Made to order
            </p>
          )
        }

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={path("contact")}
            class="group inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 text-xs font-semibold uppercase tracking-[0.16em] text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-primaryDark"
          >
            {i18n.products.request_sample}
            <FiArrowUpRight
              className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>

      <div class="relative aspect-4/3 overflow-hidden rounded-[2rem] border border-line">
        <Image
          src={cover}
          alt={title}
          widths={[480, 768, 1280]}
          sizes="(min-width: 1024px) 48vw, 92vw"
          loading="eager"
          class="h-full w-full object-cover"
          transition:name={`product-image-${slug}`}
        />
      </div>
    </div>
  </section>

  <section class="section-y bg-canvas">
    <div class="container-x grid gap-14 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
      <div class="prose prose-neutral max-w-none dark:prose-invert prose-headings:font-display prose-a:text-primary">
        <Content />
      </div>

      {
        specs.length > 0 && (
          <aside class="h-fit rounded-3xl border border-line bg-panel p-8">
            <h2 class="font-display text-lg font-semibold text-ink">{i18n.products.detail.specs}</h2>
            <dl class="mt-6 divide-y divide-line">
              {specs.map(({ label, value }) => (
                <div class="flex items-start justify-between gap-6 py-3.5">
                  <dt class="text-sm text-muted">{label}</dt>
                  <dd class="text-right text-sm font-medium text-ink">{value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        )
      }
    </div>
  </section>

  {
    gallery && (
      <section class="section-y bg-panel pt-0">
        <div class="container-x">
          <Gallery name={gallery ?? DEFAULT_GALLERY} title={i18n.products.detail.gallery_title} />
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section-y bg-canvas">
        <div class="container-x">
          <h2 class="font-display text-2xl font-bold text-ink">{i18n.products.detail.related}</h2>

          <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            {related.map((item) => (
              <li>
                <a
                  href={path("products", item.data.slug)}
                  class="group flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-canvas transition-all duration-500 hover:-translate-y-1 hover:border-primary/40"
                >
                  <div class="aspect-4/3 overflow-hidden">
                    <Image
                      src={item.data.cover}
                      alt={item.data.title}
                      width={400}
                      height={300}
                      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  </div>
                  <div class="flex flex-1 flex-col p-5">
                    <span class="text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-primary">
                      {item.data.code}
                    </span>
                    <h3 class="mt-1.5 font-display text-sm font-semibold leading-snug text-ink">
                      {item.data.title}
                    </h3>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <CtaSection
    title={i18n.products.detail.cta.title}
    description={i18n.products.detail.cta.description}
    primaryLabel={i18n.products.detail.cta.primary}
    primaryHref={path("contact")}
    secondaryLabel={i18n.products.detail.cta.secondary}
    secondaryHref={path("products")}
  />
</Layout>
