---
import {
  FiArrowUpRight,
  FiBox,
  FiCheckCircle,
  FiDownload,
  FiFileText,
  FiHelpCircle,
  FiLayers,
  FiShield,
  FiTruck,
  FiTool,
} from "react-icons/fi";
import bannerImage from "@/assets/images/bath2.avif";
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/shared/Banner.astro";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import CtaSection from "@/components/shared/CtaSection.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import CheckList from "@/components/resources/CheckList.astro";
import Faq from "@/components/resources/Faq";
import SectionNav from "@/components/resources/SectionNav.astro";
import SpecTable from "@/components/resources/SpecTable.astro";
import StepList from "@/components/resources/StepList.astro";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";
import { CATALOGS, SITE } from "@/constants/site";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const copy = i18n.resources;
const { manufacturing, shipping, installation, warranty, faq, downloads } =
  copy;

// Catalog copy already lives in `home.catalogs`; this page reuses it rather
// than keeping a second list of the same PDFs in sync.
const documents = i18n.home.catalogs.items
  .map((item) => ({
    ...item,
    file: CATALOGS.find((entry) => entry.id === item.id)?.file,
  }))
  .filter((item): item is typeof item & { file: string } => Boolean(item.file));

const warrantyMailto = `mailto:${SITE.email}?subject=${encodeURIComponent(
  `${warranty.claim.title} — ${SITE.name}`,
)}`;

// Google reads the answers from here, so the accordion can start closed without
// costing the page its rich result.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.groups.flatMap((group) =>
    group.items.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  ),
};
---

<Layout title={copy.title} description={copy.subtitle}>
  <Banner
    title={copy.title}
    subtitle={copy.banner_subtitle}
    image={bannerImage}
    imageAlt={copy.title}
  />

  <SectionNav label={copy.nav_label} sections={copy.sections} />

  <!-- ── Manufacturing ─────────────────────────────────────────────────── -->
  <section id="manufacturing" class="section-y scroll-mt-36 bg-canvas">
    <div class="container-x">
      <p class="max-w-3xl text-base leading-relaxed text-pretty text-muted">
        {copy.intro}
      </p>

      <div class="mt-16">
        <SectionHeading
          eyebrow={manufacturing.eyebrow}
          title={manufacturing.title}
          description={manufacturing.description}
        >
          <FiBox slot="icon" className="h-5 w-5" aria-hidden="true" />
        </SectionHeading>
      </div>

      <dl
        class="mt-12 grid gap-px overflow-hidden rounded-3xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
      >
        {
          manufacturing.stats.map(({ value, label, note }) => (
            <div class="bg-canvas p-7">
              <dt class="type-label text-muted">{label}</dt>
              <dd>
                <p class="mt-3 font-display text-3xl font-bold tracking-[-0.025em] text-strategic">
                  {value}
                </p>
                <p class="mt-2 text-sm leading-relaxed text-muted">{note}</p>
              </dd>
            </div>
          ))
        }
      </dl>

      <div
        class="mt-16 grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]"
      >
        <div>
          <StepList
            title={manufacturing.steps_title}
            steps={manufacturing.steps}
          />
        </div>

        <ScrollReveal client:visible direction="up" className="lg:pt-4">
          <div class="surface-card sticky top-36 rounded-4xl p-8 sm:p-10">
            <span
              class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-strategic"
            >
              <FiLayers className="h-5 w-5" aria-hidden="true" />
            </span>
            <h3 class="type-heading mt-6 text-ink">{downloads.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-pretty text-muted">
              {downloads.description}
            </p>

            <ul class="mt-7 space-y-3">
              {
                documents.map(({ id, title, description, file }) => (
                  <li>
                    <a
                      href={file}
                      download
                      data-catalog={id}
                      class="press-soft group flex items-start gap-4 rounded-2xl border border-line bg-panel p-5 hover:border-primary/40"
                    >
                      <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-canvas text-strategic">
                        <FiFileText className="h-4 w-4" aria-hidden="true" />
                      </span>
                      <span class="flex-1">
                        <span class="block font-display text-sm font-semibold text-ink">
                          {title}
                        </span>
                        <span class="mt-1 block text-xs leading-relaxed text-muted">
                          {description}
                        </span>
                      </span>
                      <FiDownload
                        className="mt-1 h-4 w-4 shrink-0 text-muted transition-[transform,color] duration-300 ease-out group-hover:translate-y-0.5 group-hover:text-strategic"
                        aria-hidden="true"
                      />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <!-- ── Shipping & handling ───────────────────────────────────────────── -->
  <section id="shipping" class="section-y scroll-mt-36 bg-panel">
    <div class="container-x">
      <SectionHeading
        eyebrow={shipping.eyebrow}
        title={shipping.title}
        description={shipping.description}
      >
        <FiTruck slot="icon" className="h-5 w-5" aria-hidden="true" />
      </SectionHeading>

      <h3 class="type-heading mt-14 text-ink">{shipping.phases_title}</h3>
      <div class="mt-8">
        <StepList steps={shipping.phases} variant="grid" />
      </div>

      <div class="mt-16">
        <h3 class="type-heading text-ink">{shipping.equipment.title}</h3>
        <p
          class="mt-3 max-w-2xl text-sm leading-relaxed text-pretty text-muted"
        >
          {shipping.equipment.description}
        </p>
        <div class="mt-7">
          <SpecTable
            caption={shipping.equipment.title}
            columns={shipping.equipment.columns}
            rows={shipping.equipment.rows}
            note={shipping.equipment.note}
          />
        </div>
      </div>

      <div class="mt-16 grid gap-10 lg:grid-cols-3">
        <CheckList
          title={shipping.receiving.title}
          description={shipping.receiving.description}
          items={shipping.receiving.items}
          class="surface-card rounded-3xl p-8"
        />
        <CheckList
          title={shipping.storage.title}
          description={shipping.storage.description}
          items={shipping.storage.items}
          class="surface-card rounded-3xl p-8"
        />
        <CheckList
          tone="note"
          title={shipping.claims.title}
          description={shipping.claims.description}
          items={shipping.claims.items}
          class="surface-card rounded-3xl p-8"
        />
      </div>

      <p
        class="mt-10 rounded-3xl border border-dashed border-line px-7 py-6 text-sm leading-relaxed text-pretty text-muted"
      >
        {shipping.returns_note}
      </p>
    </div>
  </section>

  <!-- ── Installation ──────────────────────────────────────────────────── -->
  <section id="installation" class="section-y scroll-mt-36 bg-canvas">
    <div class="container-x">
      <SectionHeading
        eyebrow={installation.eyebrow}
        title={installation.title}
        description={installation.description}
      >
        <FiTool slot="icon" className="h-5 w-5" aria-hidden="true" />
      </SectionHeading>

      <!-- Steps: full-width grid of cards -->
      <div class="mt-8">
        <StepList
          title={installation.steps_title}
          steps={installation.steps}
          variant="compact"
        />
      </div>

      <!-- Specs + Retrofit: full-width, side by side -->
      <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_minmax(0,20rem)]">
        <div>
          <h3 class="type-heading text-ink">{installation.specs.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">
            {installation.specs.description}
          </p>
          <div class="mt-5">
            <SpecTable
              caption={installation.specs.title}
              columns={installation.specs.columns}
              rows={installation.specs.rows}
            />
          </div>
        </div>

        <div
          class="rounded-2xl border border-strategic/20 bg-strategic/5 px-6 py-6 lg:self-start lg:mt-[3.25rem]"
        >
          <h4
            class="font-display text-base font-semibold tracking-[-0.01em] text-strategic"
          >
            {installation.retrofit.title}
          </h4>
          <p class="mt-2 text-sm leading-relaxed text-pretty text-muted">
            {installation.retrofit.description}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Warranty ──────────────────────────────────────────────────────── -->
  <section id="warranty" class="section-y scroll-mt-36 bg-panel">
    <div class="container-x">
      <SectionHeading
        eyebrow={warranty.eyebrow}
        title={warranty.title}
        description={warranty.description}
      >
        <FiShield slot="icon" className="h-5 w-5" aria-hidden="true" />
      </SectionHeading>

      <h3 class="sr-only">{warranty.coverage_title}</h3>
      <ul class="mt-14 grid gap-5 lg:grid-cols-3">
        {
          warranty.coverage.map(({ term, title, description }, index) => (
            <ScrollReveal
              client:visible
              delay={index * 0.08}
              className="h-full"
            >
              <li class="surface-card press-soft flex h-full flex-col rounded-3xl p-8 hover:shadow-e2">
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-strategic">
                  {index === 0 && (
                    <FiShield className="h-4 w-4" aria-hidden="true" />
                  )}
                  {index === 1 && (
                    <FiLayers className="h-4 w-4" aria-hidden="true" />
                  )}
                  {index === 2 && (
                    <FiCheckCircle className="h-4 w-4" aria-hidden="true" />
                  )}
                </span>
                <p class="font-display text-4xl font-bold tracking-[-0.03em] text-strategic">
                  {term}
                </p>
                <h4 class="mt-5 font-display text-base font-semibold tracking-[-0.01em] text-ink">
                  {title}
                </h4>
                <p class="mt-2.5 text-sm leading-relaxed text-pretty text-muted">
                  {description}
                </p>
              </li>
            </ScrollReveal>
          ))
        }
      </ul>

      <div class="mt-10 grid gap-10 md:grid-cols-2">
        <CheckList
          title={warranty.included.title}
          items={warranty.included.items}
          class="surface-card rounded-3xl p-8"
        />
        <CheckList
          tone="cross"
          title={warranty.excluded.title}
          items={warranty.excluded.items}
          class="surface-card rounded-3xl p-8"
        />
      </div>

      <div class="mt-10 grid gap-10 lg:grid-cols-2">
        <div class="surface-card rounded-3xl p-8">
          <h3 class="type-heading text-ink">{warranty.claim.title}</h3>
          <ol class="mt-6 space-y-4">
            {
              warranty.claim.steps.map((step, index) => (
                <li class="flex items-start gap-4">
                  <span class="type-label inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-primary/10 tabular-nums text-strategic">
                    {index + 1}
                  </span>
                  <span class="text-sm leading-relaxed text-pretty text-muted">
                    {step}
                  </span>
                </li>
              ))
            }
          </ol>
        </div>

        <CheckList
          title={warranty.care.title}
          description={warranty.care.description}
          items={warranty.care.items}
          class="surface-card rounded-3xl p-8"
        />
      </div>

      <div class="mt-10">
        <a href={warrantyMailto} class="btn btn-primary group">
          {warranty.claim.cta}
          <FiArrowUpRight
            className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            aria-hidden="true"
          />
        </a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────────────── -->
  <section id="faq" class="section-y scroll-mt-36 bg-canvas">
    <div
      class="container-x grid gap-12 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-20"
    >
      <div class="lg:sticky lg:top-36 lg:self-start">
        <SectionHeading
          eyebrow={faq.eyebrow}
          title={faq.title}
          description={faq.description}
        >
          <FiHelpCircle slot="icon" className="h-5 w-5" aria-hidden="true" />
        </SectionHeading>
        <a
          href={path("contact")}
          class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-strategic transition-colors hover:text-primaryDark"
        >
          {i18n.contact.form.title}
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <Faq client:visible groups={faq.groups} allLabel={i18n.common.all} />
    </div>
  </section>

  <CtaSection
    eyebrow={copy.cta.eyebrow}
    title={copy.cta.title}
    description={copy.cta.description}
    primaryLabel={copy.cta.primary}
    primaryHref={path("contact")}
    secondaryLabel={copy.cta.secondary}
    secondaryHref={path("products")}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    is:inline
  />
</Layout>
