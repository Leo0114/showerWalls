---
import { Image } from "astro:assets";
import { FiMenu, FiX } from "react-icons/fi";
import logo from "@/assets/sw-logo.png";
import ThemeToggle from "@/components/shared/ThemeToggle.astro";
import LangToggle from "@/components/shared/LangToggle.astro";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";
import { NAV_ITEMS, SITE } from "@/constants/site";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const current = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = NAV_ITEMS.map(({ route, key }) => {
  const href = path(route);
  const normalized = href.replace(/\/$/, "") || "/";
  return {
    href,
    label: i18n.nav[key as keyof typeof i18n.nav],
    isActive:
      normalized === "/" ? current === "/" : current.startsWith(normalized),
  };
});
---

<header
  id="site-header"
  class="glass-chrome sticky top-0 z-50 border-b border-transparent transition-[border-color,box-shadow] duration-300 ease-out"
>
  <div class="container-x flex h-18 items-center justify-between gap-6 py-3">
    <a
      href={path("index")}
      class="press flex shrink-0 items-center gap-3"
      aria-label={SITE.name}
    >
      <Image
        src={logo}
        alt={SITE.name}
        width={180}
        height={65}
        loading="eager"
        class="h-9 w-auto object-contain md:h-11"
        transition:name="site-logo"
      />
    </a>

    <nav aria-label={i18n.nav.menu} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          links.map(({ href, label, isActive }) => (
            <li>
              <a
                href={href}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "press relative rounded-full px-4 py-2 text-sm font-medium",
                  isActive ? "text-strategic" : "text-muted hover:bg-panel/70 hover:text-ink",
                ]}
              >
                {label}
                {isActive && (
                  <span
                    class="absolute inset-x-4 -bottom-0.5 h-0.5 rounded-full bg-primary"
                    transition:name="nav-indicator"
                  />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden items-center gap-2 lg:flex">
        <LangToggle label={i18n.nav.language} />
        <ThemeToggle label={i18n.nav.theme} />
      </div>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={i18n.nav.menu}
        class="icon-btn lg:hidden"
      >
        <FiMenu className="block h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

{
  /* Mobile menu lives OUTSIDE <header> to avoid backdrop-filter containing block */
}
<div
  id="mobile-menu"
  data-menu-panel
  data-motion
  hidden
  class="fixed inset-0 z-60 flex -translate-y-3 flex-col bg-canvas opacity-0 transition-[opacity,transform] duration-300 ease-out data-[open]:translate-y-0 data-[open]:opacity-100 lg:hidden"
>
  <div class="container-x flex h-18 items-center justify-between py-3">
    <Image
      src={logo}
      alt={SITE.name}
      width={168}
      height={60}
      class="h-9 w-auto object-contain"
    />
    <button
      type="button"
      data-menu-close
      aria-label={i18n.nav.close}
      class="icon-btn"
    >
      <FiX className="h-5 w-5" aria-hidden="true" />
    </button>
  </div>

  <nav
    aria-label={i18n.nav.menu}
    class="container-x flex flex-1 flex-col justify-center pb-16"
  >
    <ul class="flex flex-col gap-1">
      {
        links.map(({ href, label, isActive }, index) => (
          <li>
            <a
              href={href}
              aria-current={isActive ? "page" : undefined}
              style={`--i:${index}`}
              data-menu-item
              class:list={[
                "press block border-b border-line/60 py-4 font-display text-2xl font-semibold tracking-[-0.02em]",
                isActive ? "text-strategic" : "text-ink hover:text-strategic",
              ]}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2">
        <LangToggle label={i18n.nav.language} />
        <ThemeToggle label={i18n.nav.theme} />
      </div>
      <!-- <a
        href={path("contact")}
        class="rounded-full bg-primary px-6 py-3 text-xs font-semibold uppercase tracking-[0.16em] text-white"
      >
        {i18n.nav.cta}
      </a> -->
    </div>
  </nav>
</div>

<style>
  /* The items arrive just behind the panel, in reading order, so the menu reads
     as one surface settling rather than six things appearing at once. */
  [data-menu-item] {
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity 320ms var(--ease-out-soft),
      transform 320ms var(--ease-out-soft);
    transition-delay: calc(var(--i) * 40ms + 60ms);
  }

  [data-open] [data-menu-item] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-menu-item] {
      transform: none;
      transition-delay: 0ms;
    }
  }
</style>

<script>
  const OPEN_CLASS = "overflow-hidden";
  /** Matches the panel's transition so the element is only hidden once it has
      finished fading out — an interrupted close can still be re-opened. */
  const EXIT_MS = 300;

  let exitTimer: ReturnType<typeof setTimeout> | undefined;

  const setMenu = (open: boolean) => {
    const panel = document.querySelector<HTMLElement>("[data-menu-panel]");
    const toggle = document.querySelector<HTMLElement>("[data-menu-toggle]");
    if (!panel || !toggle) return;

    clearTimeout(exitTimer);
    toggle.setAttribute("aria-expanded", String(open));
    document.body.classList.toggle(OPEN_CLASS, open);

    if (open) {
      panel.hidden = false;
      // One frame with the panel laid out but still closed, so the browser has
      // a start value to animate *from* instead of snapping to the end state.
      requestAnimationFrame(() => panel.setAttribute("data-open", ""));
      return;
    }

    panel.removeAttribute("data-open");
    exitTimer = setTimeout(() => {
      if (!panel.hasAttribute("data-open")) panel.hidden = true;
    }, EXIT_MS);
  };

  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    if (!target) return;

    if (target.closest("[data-menu-toggle]")) return setMenu(true);
    if (target.closest("[data-menu-close]")) return setMenu(false);
    if (target.closest("[data-menu-panel] a")) return setMenu(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });

  // The hairline and the shadow only exist while content is actually running
  // underneath the bar; at the top of the page the chrome has nothing to
  // separate itself from.
  const onScroll = () => {
    const header = document.getElementById("site-header");
    const scrolled = window.scrollY > 8;
    header?.classList.toggle("shadow-e2", scrolled);
    header?.classList.toggle("border-line/70", scrolled);
    header?.classList.toggle("border-transparent", !scrolled);
  };

  document.addEventListener("astro:page-load", () => {
    setMenu(false);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  });

  document.addEventListener("astro:before-swap", () => {
    window.removeEventListener("scroll", onScroll);
    document.body.classList.remove(OPEN_CLASS);
  });
</script>
