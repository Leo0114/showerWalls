---
import { Image } from "astro:assets";
import { FiFacebook, FiInstagram, FiLinkedin, FiMail, FiMapPin, FiPhone } from "react-icons/fi";
import logo from "@/assets/sw-logo.png";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";
import { NAV_ITEMS, PRODUCT_CATEGORIES, SITE } from "@/constants/site";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const year = new Date().getFullYear();

const socials = [
  { href: SITE.social.instagram, label: "Instagram", Icon: FiInstagram },
  { href: SITE.social.facebook, label: "Facebook", Icon: FiFacebook },
  { href: SITE.social.linkedin, label: "LinkedIn", Icon: FiLinkedin },
];
---

<footer class="border-t border-line bg-panel">
  <div class="container-x grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <Image src={logo} alt={SITE.name} width={200} height={56} class="h-11 w-auto object-contain" />
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-muted">{i18n.footer.tagline}</p>

      <ul class="mt-6 flex items-center gap-3">
        {
          socials.map(({ href, label, Icon }) => (
            <li>
              <a
                href={href}
                target="_blank"
                rel="noreferrer noopener"
                aria-label={label}
                class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-line text-muted transition-colors duration-300 hover:border-primary hover:text-primary"
              >
                <Icon className="h-4 w-4" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <nav aria-labelledby="footer-nav">
      <h2 id="footer-nav" class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-ink">
        {i18n.footer.navigation}
      </h2>
      <ul class="mt-5 space-y-3">
        {
          NAV_ITEMS.map(({ route, key }) => (
            <li>
              <a
                href={path(route)}
                class="text-sm text-muted transition-colors duration-300 hover:text-primary"
              >
                {i18n.nav[key as keyof typeof i18n.nav]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-catalog">
      <h2 id="footer-catalog" class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-ink">
        {i18n.footer.catalog}
      </h2>
      <ul class="mt-5 space-y-3">
        {
          PRODUCT_CATEGORIES.map((category) => (
            <li>
              <a
                href={`${path("products")}?category=${category}`}
                class="text-sm text-muted transition-colors duration-300 hover:text-primary"
              >
                {i18n.products.categories[category].name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <address class="not-italic">
      <h2 class="font-display text-sm font-semibold uppercase tracking-[0.2em] text-ink">
        {i18n.footer.contact}
      </h2>
      <ul class="mt-5 space-y-4 text-sm text-muted">
        <li class="flex items-start gap-3">
          <FiMapPin className="mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
          <span>{i18n.contact.info.address}</span>
        </li>
        <li class="flex items-start gap-3">
          <FiPhone className="mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
          <a href={SITE.phoneHref} class="transition-colors hover:text-primary">{SITE.phone}</a>
        </li>
        <li class="flex items-start gap-3">
          <FiMail className="mt-0.5 h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
          <a href={`mailto:${SITE.email}`} class="transition-colors hover:text-primary">{SITE.email}</a>
        </li>
        <li class="pt-1 text-xs">{i18n.contact.info.hours}</li>
      </ul>
    </address>
  </div>

  <div class="border-t border-line">
    <div class="container-x flex flex-col items-center justify-between gap-2 py-6 text-xs text-muted sm:flex-row">
      <p>&copy; {year} {SITE.name}. {i18n.footer.rights}</p>
      <p>{SITE.url.replace("https://", "")}</p>
    </div>
  </div>
</footer>
