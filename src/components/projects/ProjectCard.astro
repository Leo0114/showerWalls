---
/**
 * ProjectCard — driven by proyectos.json entries.
 *
 * Props surface only the flat JSON fields we actually render;
 * the parent island passes them after filtering / paginating.
 */

import { Image } from "astro:assets";
import { FiExternalLink } from "react-icons/fi";

import hospitalityImg from "@/assets/images/projects/hospital.avif";
import multifamilyImg from "@/assets/images/projects/multifam.avif";
import seniorlivingImg from "@/assets/images/projects/student.avif";

export interface ProjectEntry {
  Tipo: string;
  Hotel: string;
  Marca: string | null;
  City: string | null;
  State: string | null;
  Web: string | null;
}

interface Props {
  project: ProjectEntry;
  visitLabel: string;
}

const { project, visitLabel } = Astro.props;
const { Tipo, Hotel, Marca, City, State, Web } = project;

// Pick the representative image per type — no external fetch needed.
const typeImage =
  Tipo === "Multifamily"
    ? multifamilyImg
    : Tipo === "Seniorliving"
      ? seniorlivingImg
      : hospitalityImg;

const location = [City, State].filter(Boolean).join(", ");
---

<a
  href={Web ?? "#"}
  target={Web ? "_blank" : undefined}
  rel={Web ? "noopener noreferrer" : undefined}
  aria-label={Hotel}
  class="surface-card press-soft group relative flex flex-col overflow-hidden rounded-2xl hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-e3"
>
  <!-- Type image strip -->
  <div class="relative h-36 overflow-hidden">
    <Image
      src={typeImage}
      alt={Tipo}
      widths={[320, 480]}
      sizes="(min-width: 1280px) 25vw, (min-width: 768px) 33vw, 50vw"
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
    />
    <!-- Gradient overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-baseBlack/60 via-baseBlack/10 to-transparent opacity-80"
      aria-hidden="true"
    ></div>
    <!-- Type badge -->
    <span class="glass-chip type-label absolute top-3 left-3 rounded-full px-2.5 py-1 text-strategic">
      {Tipo === "Seniorliving" ? "Senior Living" : Tipo}
    </span>
    <!-- External link icon -->
    {
      Web && (
        <span class="absolute top-3 right-3 flex h-7 w-7 items-center justify-center rounded-full bg-strategic/90 text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100">
          <FiExternalLink className="h-3.5 w-3.5" aria-hidden="true" />
        </span>
      )
    }
  </div>

  <!-- Card body -->
  <div class="flex flex-1 flex-col gap-1.5 p-4">
    <!-- Hotel name -->
    <h3 class="font-display text-[0.875rem] leading-snug font-bold tracking-[-0.01em] text-ink line-clamp-2 transition-colors duration-200 group-hover:text-strategic">
      {Hotel}
    </h3>

    <!-- Meta row: brand · location -->
    <p class="type-label mt-0.5 text-muted line-clamp-1">
      {[Marca?.trim(), location].filter(Boolean).join(" · ")}
    </p>

    <!-- Visit label -->
    {
      Web && (
        <span class="type-label mt-auto pt-3 inline-flex items-center gap-1.5 text-strategic">
          {visitLabel}
          <FiExternalLink
            className="h-3 w-3 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            aria-hidden="true"
          />
        </span>
      )
    }
  </div>
</a>
