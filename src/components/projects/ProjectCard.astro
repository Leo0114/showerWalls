---
import { Image } from "astro:assets";
import { FiArrowUpRight } from "react-icons/fi";
import type { Project } from "@/lib/content";

interface Props {
  project: Project;
  href: string;
  label: string;
  /** First card gets the eager fetch and a wider span. */
  featured?: boolean;
}

const { project, href, label, featured = false } = Astro.props;
const { title, excerpt, cover, client, location, year, sector, slug } = project.data;
---

<a
  href={href}
  class:list={[
    "surface-card press-soft group relative flex h-full flex-col overflow-hidden rounded-3xl hover:-translate-y-1 hover:border-primary/40 hover:shadow-e3",
    featured && "lg:col-span-2",
  ]}
>
  <div class:list={["relative overflow-hidden", featured ? "aspect-16/10" : "aspect-4/3"]}>
    <Image
      src={cover}
      alt={title}
      widths={[480, 768, 1280]}
      sizes={featured ? "(min-width: 1024px) 60vw, 92vw" : "(min-width: 1024px) 30vw, 92vw"}
      loading={featured ? "eager" : "lazy"}
      class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
      transition:name={`project-image-${slug}`}
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-baseBlack/70 via-baseBlack/10 to-transparent opacity-80"
      aria-hidden="true"
    >
    </div>
    <span class="glass-chip type-label absolute top-5 left-5 rounded-full px-3 py-1 text-strategic">
      {sector}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-7">
    <p class="type-label text-muted">
      {client} · {location} · {year}
    </p>

    <h3
      class="mt-3 font-display text-xl leading-snug font-bold tracking-[-0.02em] text-ink transition-colors duration-300 ease-out group-hover:text-strategic"
      transition:name={`project-title-${slug}`}
    >
      {title}
    </h3>

    <p class="mt-3 flex-1 text-sm leading-relaxed text-pretty text-muted">{excerpt}</p>

    <span class="type-label mt-6 inline-flex items-center gap-2 text-strategic">
      {label}
      <FiArrowUpRight
        className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        aria-hidden="true"
      />
    </span>
  </div>
</a>
