---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  tone?: "default" | "inverted";
  class?: string;
  /** Heading level — sections inside a page should not all be `h2`. */
  as?: "h1" | "h2" | "h3";
}

const {
  eyebrow,
  title,
  description,
  align = "left",
  tone = "default",
  as: Tag = "h2",
  class: className = "",
} = Astro.props;

const isCenter = align === "center";
const isInverted = tone === "inverted";
---

<div class:list={["max-w-2xl", isCenter && "mx-auto text-center", className]}>
  {
    Astro.slots.has("icon") && (
      <div
        class:list={[
          "mb-6 inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-strategic",
          isCenter && "mx-auto",
        ]}
      >
        <slot name="icon" />
      </div>
    )
  }
  {
    eyebrow && (
      <p
        class:list={[
          "type-eyebrow flex items-center gap-3",
          isCenter && "justify-center",
          isInverted ? "text-secondary" : "text-strategic",
        ]}
      >
        <span
          class:list={[
            "h-px w-8",
            isInverted ? "bg-secondary/60" : "bg-primary/40",
          ]}
        />
        {eyebrow}
      </p>
    )
  }

  {
    /* `type-title` carries the size-specific tracking and leading, so a heading
      never inherits a letter-spacing tuned for a different size. */
  }
  <Tag class:list={["type-title mt-4", isInverted ? "text-white" : "text-ink"]}>
    {title}
  </Tag>

  {
    description && (
      <p
        class:list={[
          "type-body mt-5",
          isInverted ? "text-white/75" : "text-muted",
        ]}
      >
        {description}
      </p>
    )
  }
</div>
