---
import { FiArrowUp } from "react-icons/fi";
import { getI18N, getLang } from "@/i18n/i18n";

const i18n = getI18N(getLang(Astro.currentLocale));
---

<button
  id="scroll-to-top"
  type="button"
  aria-label={i18n.footer.back_to_top}
  data-motion
  class="press glass-chrome sheen-top pointer-events-none fixed right-6 bottom-6 z-50 flex h-12 w-12 cursor-pointer translate-y-4 scale-90 items-center justify-center rounded-full border border-line text-ink opacity-0 shadow-e3 transition-[opacity,transform] duration-300 ease-out sm:right-8 sm:bottom-8"
>
  <FiArrowUp className="h-5 w-5" aria-hidden="true" />
</button>

<script>
  // The button appears once "back to top" is a real distance away, and it
  // arrives from the direction it will send you — up.
  const REVEAL_AT = 320;

  let onScroll: (() => void) | undefined;

  function initScrollTop() {
    const btn = document.getElementById("scroll-to-top");
    if (!btn) return;

    const render = () => {
      const visible = window.scrollY > REVEAL_AT;
      btn.classList.toggle("opacity-0", !visible);
      btn.classList.toggle("translate-y-4", !visible);
      btn.classList.toggle("scale-90", !visible);
      btn.classList.toggle("pointer-events-none", !visible);
      btn.classList.toggle("opacity-100", visible);
      btn.classList.toggle("translate-y-0", visible);
      btn.classList.toggle("scale-100", visible);
    };

    if (onScroll) window.removeEventListener("scroll", onScroll);
    onScroll = render;
    window.addEventListener("scroll", onScroll, { passive: true });
    render();
  }

  // Delegated so it survives view transitions without re-binding.
  document.addEventListener("click", (event) => {
    if (!(event.target as Element | null)?.closest("#scroll-to-top")) return;
    const reduce = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
  });

  document.addEventListener("astro:page-load", initScrollTop);
  document.addEventListener("astro:before-swap", () => {
    if (onScroll) window.removeEventListener("scroll", onScroll);
    onScroll = undefined;
  });
</script>
