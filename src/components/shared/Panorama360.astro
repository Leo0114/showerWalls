---
import { getImage } from "astro:assets";
import { FiMove } from "react-icons/fi";

interface Props {
  /** File names (without extension) inside `src/assets/images/360/`. */
  names: string[];
  title?: string;
  hint?: string;
}

const { names, title, hint } = Astro.props;

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/360/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}",
  { eager: true },
);

const available = Object.entries(modules).map(([path, mod]) => ({
  name: path.split("/").pop()!.replace(/\.[^.]+$/, ""),
  image: mod.default,
}));

// Equirectangular panoramas are huge (9k+ wide); downscale once at build time.
const panoramas = await Promise.all(
  names
    .map((name) => available.find((entry) => entry.name === name))
    .filter((entry): entry is (typeof available)[number] => Boolean(entry))
    .map(async ({ name, image }) => ({
      name,
      src: (await getImage({ src: image, width: 3200, format: "webp", quality: 75 })).src,
    })),
);
---

{
  panoramas.length > 0 && (
    <section class="panorama-block">
      {title && (
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
          <h2 class="font-display text-2xl font-bold text-ink">{title}</h2>
          {hint && (
            <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.16em] text-muted">
              <FiMove className="h-4 w-4" aria-hidden="true" />
              {hint}
            </p>
          )}
        </div>
      )}

      <div class="grid gap-5 md:grid-cols-2">
        {panoramas.map(({ name, src }) => (
          <figure
            data-panorama
            style={`background-image:url(${src})`}
            class="panorama relative aspect-video cursor-grab touch-pan-y overflow-hidden rounded-2xl border border-line bg-panel active:cursor-grabbing"
            role="img"
            aria-label={`360° ${name}`}
          >
            <span class="pointer-events-none absolute bottom-3 right-3 rounded-full bg-baseBlack/60 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-white backdrop-blur-sm">
              360°
            </span>
          </figure>
        ))}
      </div>
    </section>
  )
}

<style>
  /* repeat-x makes the horizontal pan wrap seamlessly, which is exactly the
     behaviour an equirectangular panorama needs. */
  .panorama {
    background-repeat: repeat-x;
    background-size: auto 130%;
    background-position: 50% 50%;
  }
</style>

<script>
  const DRIFT_PX_PER_FRAME = 0.15;

  let cleanups: Array<() => void> = [];

  function initPanoramas() {
    document.querySelectorAll<HTMLElement>("[data-panorama]").forEach((el) => {
      let offset = 0;
      let dragging = false;
      let lastX = 0;
      let frame = 0;
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const render = () => {
        el.style.backgroundPositionX = `${offset}px`;
      };

      const drift = () => {
        if (!dragging) {
          offset -= DRIFT_PX_PER_FRAME;
          render();
        }
        frame = requestAnimationFrame(drift);
      };

      const onDown = (event: PointerEvent) => {
        dragging = true;
        lastX = event.clientX;
        el.setPointerCapture(event.pointerId);
      };

      const onMove = (event: PointerEvent) => {
        if (!dragging) return;
        offset += event.clientX - lastX;
        lastX = event.clientX;
        render();
      };

      const onUp = (event: PointerEvent) => {
        dragging = false;
        if (el.hasPointerCapture(event.pointerId)) el.releasePointerCapture(event.pointerId);
      };

      el.addEventListener("pointerdown", onDown);
      el.addEventListener("pointermove", onMove);
      el.addEventListener("pointerup", onUp);
      el.addEventListener("pointercancel", onUp);

      if (!reduceMotion) frame = requestAnimationFrame(drift);

      cleanups.push(() => {
        cancelAnimationFrame(frame);
        el.removeEventListener("pointerdown", onDown);
        el.removeEventListener("pointermove", onMove);
        el.removeEventListener("pointerup", onUp);
        el.removeEventListener("pointercancel", onUp);
      });
    });
  }

  function destroyPanoramas() {
    cleanups.forEach((fn) => fn());
    cleanups = [];
  }

  document.addEventListener("astro:page-load", initPanoramas);
  document.addEventListener("astro:before-swap", destroyPanoramas);
</script>
