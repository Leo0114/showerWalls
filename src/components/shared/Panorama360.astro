---
import { FiMove } from "react-icons/fi";
import PanoramaViewer from "@/components/shared/PanoramaViewer";
import { panoramaLabels } from "@/lib/panoramaLabels";
import { resolvePanoramas } from "@/lib/panoramas";
import { getI18N, getLang } from "@/i18n/i18n";

interface Props {
  /** File names (without extension) inside `src/assets/images/360/`. */
  names: string[];
  title?: string;
  hint?: string;
  /** Optional per-name caption rendered over the panorama. */
  captions?: Record<string, string>;
  /** Skip the tap-to-enter step once the frame scrolls into view. */
  autoLoad?: boolean;
}

const { names, title, hint, captions = {}, autoLoad = false } = Astro.props;

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const labels = panoramaLabels(i18n);

const panoramas = await resolvePanoramas(names);
const single = panoramas.length === 1;
---

{
  panoramas.length > 0 && (
    <section class="panorama-block">
      {title && (
        <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
          <h2 class="type-heading text-ink">{title}</h2>
          {hint && (
            <p class="type-label inline-flex items-center gap-2 text-muted">
              <FiMove className="h-4 w-4" aria-hidden="true" />
              {hint}
            </p>
          )}
        </div>
      )}

      <div class:list={["grid gap-5", !single && "md:grid-cols-2"]}>
        {panoramas.map(({ name, src, poster }, index) => (
          <PanoramaViewer
            client:visible
            src={src}
            poster={poster}
            caption={captions[name]}
            labels={labels}
            aspect={single ? "aspect-16/9" : "aspect-16/10"}
            autoLoad={autoLoad && index === 0}
          />
        ))}
      </div>
    </section>
  )
}
