---
import { Image, getImage } from "astro:assets";

interface Props {
  name: string;
  title?: string;
  alt?: string;
  standardGrid?: boolean;
}

const { name, title, alt = name, standardGrid = false } = Astro.props;

// Eagerly load every gallery image; we filter to the requested folder.
const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}",
  { eager: true },
);

// Product folders ship a `one.*` cover; it leads the grid as the hero tile.
const isCover = (path: string) => /\/one\.[a-z]+$/i.test(path);

const images = Object.entries(modules)
  .filter(([path]) => path.includes(`/${name}/`))
  .sort(
    ([a], [b]) => Number(isCover(b)) - Number(isCover(a)) || a.localeCompare(b),
  )
  .map(([, mod]) => mod.default);

// Source photos run up to ~6 MB; the lightbox gets a capped WebP instead of the original.
const LIGHTBOX_MAX = 2000;
const slides = await Promise.all(
  images.map(async (img) => {
    const width = Math.min(img.width, LIGHTBOX_MAX);
    const height = Math.round((img.height * width) / img.width);
    const { src } = await getImage({ src: img, width, height, format: "webp" });
    return { src, width, height };
  }),
);

// Folder names carry spaces, `&` and slashes — not valid in a CSS id selector.
const galleryId = `pswp-${name.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}`;
---

{
  images.length > 0 && (
    <div class="gallery-block">
      {title && <h2 class="type-heading mb-5 text-ink">{title}</h2>}
      <div
        id={galleryId}
        class="grid grid-cols-2 gap-3 md:grid-cols-3"
        data-pswp-gallery
      >
        {images.map((img, i) => (
          <a
            href={slides[i].src}
            data-pswp-width={slides[i].width}
            data-pswp-height={slides[i].height}
            target="_blank"
            rel="noreferrer"
            class:list={[
              "press-soft group relative flex items-center justify-center overflow-hidden rounded-2xl bg-canvas p-8 lg:p-10",
              !standardGrid && i === 0
                ? "col-span-2 row-span-2 md:col-span-2 aspect-square"
                : "aspect-square",
            ]}
          >
            <Image
              src={img}
              alt={`${alt} ${i + 1}`}
              width={(!standardGrid && i === 0) ? 900 : 500}
              height={(!standardGrid && i === 0) ? 700 : 400}
              class="h-full w-full object-contain drop-shadow-[0_14px_18px_rgb(0_0_0/0.14)] transition-transform duration-500 ease-out group-hover:scale-[1.03]"
            />
          </a>
        ))}
      </div>
    </div>
  )
}

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  let lightboxes: PhotoSwipeLightbox[] = [];

  function initGalleries() {
    document
      .querySelectorAll<HTMLElement>("[data-pswp-gallery]")
      .forEach((el) => {
        const lb = new PhotoSwipeLightbox({
          gallery: `#${el.id}`,
          children: "a",
          pswpModule: () => import("photoswipe"),
        });
        lb.init();
        lightboxes.push(lb);
      });
  }

  function destroyGalleries() {
    lightboxes.forEach((lb) => lb.destroy());
    lightboxes = [];
  }

  document.addEventListener("astro:page-load", initGalleries);
  document.addEventListener("astro:before-swap", destroyGalleries);
</script>
