---
import { FiArrowRight } from "react-icons/fi";

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  eyebrow,
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<section class="section-y bg-primary text-white">
  <div class="container-x relative isolate overflow-hidden">
    <div
      class="pointer-events-none absolute -right-24 -top-24 -z-10 h-72 w-72 rounded-full bg-white/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="flex flex-col items-start gap-10 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        {eyebrow && <p class="type-eyebrow text-secondary">{eyebrow}</p>}
        <h2 class="type-title mt-4">{title}</h2>
        {description && <p class="type-body mt-5 text-white/80">{description}</p>}
      </div>

      <div class="flex shrink-0 flex-wrap items-center gap-3">
        <a href={primaryHref} class="btn btn-invert group">
          {primaryLabel}
          <FiArrowRight
            className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-1"
            aria-hidden="true"
          />
        </a>
        {
          secondaryLabel && secondaryHref && (
            <a href={secondaryHref} class="btn btn-glass">
              {secondaryLabel}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
