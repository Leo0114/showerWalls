---
import { FiMoon, FiSun } from "react-icons/fi";

interface Props {
  class?: string;
  label?: string;
}

const { class: className = "", label } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={label ?? "Toggle color theme"}
  class:list={[
    "inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full border border-line bg-canvas/60 text-ink transition-colors duration-300 hover:bg-panel",
    className,
  ]}
>
  <FiMoon className="block h-[18px] w-[18px] dark:hidden" aria-hidden="true" />
  <FiSun className="hidden h-[18px] w-[18px] dark:block" aria-hidden="true" />
</button>

<script>
  const STORAGE_KEY = "theme";

  const setPressedState = () => {
    const isDark = document.documentElement.classList.contains("dark");
    document
      .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
      .forEach((btn) => btn.setAttribute("aria-pressed", String(isDark)));
  };

  // Delegated so it survives view transitions without re-binding.
  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element | null)?.closest("[data-theme-toggle]");
    if (!trigger) return;

    const isDark = document.documentElement.classList.toggle("dark");
    localStorage.setItem(STORAGE_KEY, isDark ? "dark" : "light");
    setPressedState();
  });

  document.addEventListener("astro:page-load", setPressedState);
</script>
