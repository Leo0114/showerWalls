---
import { Image } from "astro:assets";
import { FiCheck } from "react-icons/fi";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";
import Intro from "@/assets/images/intro.avif";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const { eyebrow, title, description, points, stats } = i18n.home.intro;
---

<section class="section-y bg-canvas">
  <div class="container-x grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <ScrollReveal client:visible direction="right" className="relative">
      <div
        class="relative aspect-4/5 overflow-hidden rounded-4xl sm:aspect-square lg:aspect-4/5"
      >
        <Image
          src={Intro}
          alt={title}
          widths={[480, 768, 1024]}
          sizes="(min-width: 1024px) 45vw, 90vw"
          class="h-full w-full object-cover"
        />
      </div>

      <div
        class="absolute -bottom-8 -right-4 hidden w-56 rounded-2xl border border-line bg-canvas p-6 shadow-xl shadow-baseBlack/5 sm:block"
      >
        <p class="font-display text-4xl font-bold text-primary">
          {stats[0].value}
        </p>
        <p class="mt-1 text-sm leading-snug text-muted">{stats[0].label}</p>
      </div>
    </ScrollReveal>

    <div>
      <SectionHeading
        eyebrow={eyebrow}
        title={title}
        description={description}
      />

      <ul class="mt-10 grid gap-4 sm:grid-cols-2">
        {
          points.map((point) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary">
                <FiCheck className="h-3.5 w-3.5" aria-hidden="true" />
              </span>
              <span class="text-sm leading-relaxed text-muted">{point}</span>
            </li>
          ))
        }
      </ul>

      <dl class="mt-12 grid grid-cols-3 gap-6 border-t border-line pt-8">
        {
          stats.map(({ value, label }) => (
            <div>
              <dt class="sr-only">{label}</dt>
              <dd>
                <span class="block font-display text-2xl font-bold text-ink sm:text-3xl">
                  {value}
                </span>
                <span class="mt-1 block text-xs leading-snug text-muted">
                  {label}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>

      <a
        href={path("about")}
        class="mt-10 inline-flex items-center gap-2 text-sm font-semibold text-primary transition-colors hover:text-primaryDark"
      >
        {i18n.common.learn_more}
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>
