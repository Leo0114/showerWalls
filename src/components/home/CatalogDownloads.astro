---
import { FiDownload, FiFileText } from "react-icons/fi";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import { getI18N, getLang } from "@/i18n/i18n";
import { CATALOGS } from "@/constants/site";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);

const { eyebrow, title, description, items, download } = i18n.home.catalogs;

// Copy and file path are joined by id, so adding a catalog is a one-line change
// in `CATALOGS` plus its entry in both dictionaries.
const catalogs = items
  .map((item) => ({ ...item, file: CATALOGS.find((c) => c.id === item.id)?.file }))
  .filter((item): item is typeof item & { file: string } => Boolean(item.file));
---

<section class="section-y bg-canvas">
  <div class="container-x grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-center">
    <SectionHeading eyebrow={eyebrow} title={title} description={description} />

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        catalogs.map(({ id, title: name, description: text, file }) => (
          <li>
            <a
              href={file}
              download
              data-catalog={id}
              class="surface-card press-soft group flex h-full flex-col rounded-3xl bg-panel p-7 hover:-translate-y-1 hover:border-primary/40 hover:shadow-e3"
            >
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-strategic transition-colors duration-500 ease-out group-hover:bg-primary group-hover:text-white">
                <FiFileText className="h-5 w-5" aria-hidden="true" />
              </span>

              <h3 class="mt-6 font-display text-lg font-semibold tracking-[-0.015em] text-ink">
                {name}
              </h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-pretty text-muted">{text}</p>

              <span class="type-label mt-6 inline-flex items-center gap-2 text-strategic">
                <FiDownload
                  className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-y-0.5"
                  aria-hidden="true"
                />
                {download}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
