---
import { Image } from "astro:assets";
import { FiArrowUpRight } from "react-icons/fi";
import showerWalls from "@/assets/images/tubshower.png";
import accessible from "@/assets/images/accessories.png";
import pans from "@/assets/images/pans.png";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";
import { PRODUCT_CATEGORIES } from "@/constants/site";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const { eyebrow, title, description, cta } = i18n.home.products;

const images = [showerWalls, pans, accessible];

/** Categories rendered as transparent cut-outs (object-contain + radial bg). */
const CUTOUT_CATEGORY_IDS = new Set(["shower-pans", "accessories"]);

const categories = PRODUCT_CATEGORIES.map((id, index) => ({
  id,
  href: `${path("products")}?category=${id}`,
  image: images[index % images.length],
  isCutout: CUTOUT_CATEGORY_IDS.has(id),
  ...i18n.products.categories[id],
}));
---

<section class="section-y bg-panel">
  <div class="container-x">
    <div
      class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
    >
      <SectionHeading
        eyebrow={eyebrow}
        title={title}
        description={description}
      />

      <a
        href={path("products")}
        class="btn btn-outline group shrink-0 self-start lg:self-auto"
      >
        {cta}
        <FiArrowUpRight
          className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          aria-hidden="true"
        />
      </a>
    </div>

    <div class="mt-14 grid gap-5 grid-cols-2 lg:grid-cols-3">
      {
        categories.map(({ href, name, image, isCutout }, index) => (
          <ScrollReveal client:visible delay={index * 0.08} className="h-full">
            <a
              href={href}
              class="surface-card press-soft group relative flex h-full flex-col overflow-hidden rounded-3xl hover:-translate-y-1 hover:border-primary/40 hover:shadow-e3"
            >
              <div
                class={`relative aspect-4/3 overflow-hidden ${
                  isCutout
                    ? "bg-[radial-gradient(ellipse_at_50%_40%,var(--color-canvas)_0%,var(--color-panel)_75%)]"
                    : "bg-panel"
                }`}
              >
                <Image
                  src={image}
                  alt={name}
                  widths={[320, 560]}
                  sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
                  class={
                    isCutout
                      ? "h-full w-full object-contain px-10 pt-14 pb-10 drop-shadow-[0_14px_18px_rgb(0_0_0/0.14)] transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                      : "h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  }
                />
              </div>

              <div class="flex flex-1 flex-col items-center p-6 text-center">
                <h3 class="font-display text-lg leading-snug font-semibold tracking-[-0.015em] text-ink flex-1">
                  {name}
                </h3>
                <span class="type-label mt-5 inline-flex items-center gap-2 text-strategic">
                  {i18n.products.details_button}
                  <FiArrowUpRight
                    className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                    aria-hidden="true"
                  />
                </span>
              </div>
            </a>
          </ScrollReveal>
        ))
      }
    </div>
  </div>
</section>

