---
import { Image } from "astro:assets";
import { FiArrowUpRight } from "react-icons/fi";
import placeholder from "@/assets/images/placeholder.jpeg";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";
import { PRODUCT_CATEGORIES } from "@/constants/site";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const { eyebrow, title, description, cta } = i18n.home.products;

const categories = PRODUCT_CATEGORIES.map((id) => ({
  id,
  href: `${path("products")}?category=${id}`,
  ...i18n.products.categories[id],
}));
---

<section class="section-y bg-panel">
  <div class="container-x">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading eyebrow={eyebrow} title={title} description={description} />

      <a
        href={path("products")}
        class="group inline-flex shrink-0 items-center gap-2 self-start rounded-full border border-line bg-canvas px-6 py-3 text-xs font-semibold uppercase tracking-[0.16em] text-ink transition-colors duration-300 hover:border-primary hover:text-primary lg:self-auto"
      >
        {cta}
        <FiArrowUpRight
          className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          aria-hidden="true"
        />
      </a>
    </div>

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map(({ id, href, name, description: text }, index) => (
          <ScrollReveal client:visible delay={index * 0.08} className="h-full">
            <a
              href={href}
              class="group relative flex h-full flex-col overflow-hidden rounded-3xl border border-line bg-canvas transition-all duration-500 hover:-translate-y-1 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/5"
            >
              <div class="relative aspect-4/3 overflow-hidden">
                <Image
                  src={placeholder}
                  alt={name}
                  widths={[320, 560]}
                  sizes="(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
                <span class="absolute left-4 top-4 rounded-full bg-canvas/90 px-3 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-primary backdrop-blur-sm">
                  {String(index + 1).padStart(2, "0")}
                </span>
              </div>

              <div class="flex flex-1 flex-col p-6">
                <h3 class="font-display text-lg font-semibold leading-snug text-ink">{name}</h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{text}</p>
                <span class="mt-6 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-primary">
                  {i18n.common.explore}
                  <FiArrowUpRight
                    className="h-4 w-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                    aria-hidden="true"
                  />
                </span>
              </div>
            </a>
          </ScrollReveal>
        ))
      }
    </div>
  </div>
</section>
