---
import { FiArrowRight, FiCompass, FiTool, FiTruck, FiRefreshCw } from "react-icons/fi";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import ScrollReveal from "@/components/shared/ScrollReveal";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const { eyebrow, title, description, items, cta } = i18n.home.services;

const icons = [FiCompass, FiTool, FiTruck, FiRefreshCw];
---

<section class="section-y relative isolate overflow-hidden bg-baseBlack text-white">
  <div
    class="pointer-events-none absolute -left-32 top-1/4 -z-10 h-96 w-96 rounded-full bg-primary/25 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="container-x">
    <SectionHeading
      eyebrow={eyebrow}
      title={title}
      description={description}
      align="center"
      tone="inverted"
    />

    <div class="mt-14 grid gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map(({ title: name, description: text }, index) => {
          const Icon = icons[index % icons.length];
          return (
            <ScrollReveal client:visible delay={index * 0.08} className="h-full">
              <article class="group flex h-full flex-col bg-baseBlack p-8 transition-colors duration-500 ease-out hover:bg-primary/10">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/15 text-secondary transition-colors duration-500 ease-out group-hover:bg-primary group-hover:text-white">
                  <Icon className="h-5 w-5" aria-hidden="true" />
                </span>
                <h3 class="mt-6 font-display text-lg font-semibold tracking-[-0.015em] text-white">
                  {name}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-pretty text-white/65">{text}</p>
              </article>
            </ScrollReveal>
          );
        })
      }
    </div>

    <div class="mt-12 flex justify-center">
      <a href={path("contact")} class="btn btn-glass group">
        {cta}
        <FiArrowRight
          className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-1"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</section>
