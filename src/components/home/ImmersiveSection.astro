---
import { FiArrowRight } from "react-icons/fi";
import PanoramaViewer from "@/components/shared/PanoramaViewer";
import SectionHeading from "@/components/shared/SectionHeading.astro";
import { panoramaLabels } from "@/lib/panoramaLabels";
import { resolvePanorama } from "@/lib/panoramas";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const { eyebrow, title, description, caption, points, cta } = i18n.home.immersive;

const panorama = await resolvePanorama(i18n.home.immersive.panorama);
---

{
  panorama && (
    <section class="section-y relative isolate overflow-hidden bg-baseBlack text-white">
      {/* One soft light source behind the frame — depth without decoration. */}
      <div
        class="pointer-events-none absolute left-1/2 top-1/3 -z-10 h-[32rem] w-[52rem] -translate-x-1/2 rounded-full bg-primary/20 blur-[140px]"
        aria-hidden="true"
      />

      <div class="container-x">
        <SectionHeading
          eyebrow={eyebrow}
          title={title}
          description={description}
          align="center"
          tone="inverted"
        />

        <div class="mt-14">
          <PanoramaViewer
            client:visible
            src={panorama.src}
            poster={panorama.poster}
            caption={caption}
            labels={panoramaLabels(i18n)}
            aspect="aspect-4/3 sm:aspect-16/10 lg:aspect-21/9"
            className="shadow-e3 ring-1 ring-white/10"
          />
        </div>

        <ul class="mt-12 grid gap-x-10 gap-y-8 border-t border-white/10 pt-10 sm:grid-cols-3">
          {points.map(({ value, label }) => (
            <li>
              <p class="font-display text-3xl font-bold tracking-[-0.02em] text-secondary">
                {value}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-white/65">{label}</p>
            </li>
          ))}
        </ul>

        <div class="mt-12 flex justify-center">
          <a href={path("projects")} class="btn btn-glass group">
            {cta}
            <FiArrowRight
              className="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-1"
              aria-hidden="true"
            />
          </a>
        </div>
      </div>
    </section>
  )
}
