---
import Layout from "@/layouts/Layout.astro";
import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);
---

<Layout title="404" noindex>
  <section class="section-y bg-canvas">
    <div class="container-x flex min-h-[50vh] flex-col items-center justify-center text-center">
      <p class="font-display text-7xl font-extrabold tracking-[-0.04em] text-strategic/25 sm:text-8xl">404</p>
      <h1 class="type-title mt-6 text-ink">
        {i18n.common.no_results}
      </h1>
      <a
        href={path("index")}
        class="btn btn-primary mt-10"
      >
        {i18n.nav.home}
      </a>
    </div>
  </section>
</Layout>
